<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Removed only part of the data (%lld records):</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Removed only part of the data (%#@records@):</string>
		<key>records</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld record</string>
			<key>other</key>
			<string>%lld records</string>
		</dict>
	</dict>
	<key>Rebuilding Chroma: %lld of %lld documents (%@).</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Rebuilding Chroma: %1$lld of %2$#@documents@ (%3$@).</string>
		<key>documents</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld document</string>
			<key>other</key>
			<string>%2$lld documents</string>
		</dict>
	</dict>
</dict>
</plist>
