    "safety": "safe",
    "paths": ["~/Library/Application Support/BraveSoftware/Brave-Browser/*/Service Worker/CacheStorage", "~/Library/Application Support/BraveSoftware/Brave-Browser/*/Service Worker/ScriptCache"],
    "group": true,
    "childTitle": "parentAndName",
    "action": { "type": "trash" },
    "requiresAppClosed": true,
    "ownerBundleIDs": ["com.brave.Browser"]
  },
