[
  {
    "id": "brave.cache",
    "category": "browsers",
    "app": "Brave",
    "title": "Brave cache",
    "description": "Downloaded pages, images and scripts, plus compiled page code. Quit Brave before removing it.",
    "regeneration": "Pages load again from the network.",
    "safety": "safe",
    "paths": [
      "~/Library/Caches/BraveSoftware",
      "~/Library/Application Support/BraveSoftware/Brave-Browser/*/Code Cache",
      "~/Library/Application Support/BraveSoftware/Brave-Browser/*/GPUCache",
      "~/Library/Application Support/BraveSoftware/Brave-Browser/component_crx_cache",
      "~/Library/Application Support/BraveSoftware/Brave-Browser/extensions_crx_cache"
    ],
    "group": true,
    "childTitle": "parentAndName",
    "action": { "type": "trash" },
    "requiresAppClosed": true,
    "ownerBundleIDs": ["com.brave.Browser"]
  },
  {
    "id": "brave.serviceworker",
    "category": "browsers",
    "app": "Brave",
    "title": "Brave Service Worker storage",
