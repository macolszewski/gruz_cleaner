    ],
    "action": {
      "type": "trash"
    },
    "requiresAppClosed": true,
    "ownerBundleIDs": [
      "com.spotify.client"
    ]
  },
  {
    "id": "jetbrains.caches",
    "category": "apps",
    "app": "JetBrains",
    "title": "JetBrains IDE caches and indexes",
    "description": "Project indexes, compilation caches and downloaded resources of Rider, PyCharm, DataGrip and other JetBrains IDEs, one folder per IDE.",
    "regeneration": "The IDE reindexes projects when you open them (a few minutes).",
    "safety": "safe",
    "paths": [
      "~/Library/Caches/JetBrains/*"
    ],
    "group": true,
    "action": {
      "type": "trash"
    },
    "requiresAppClosed": true,
    "ownerBundleIDs": [
      "com.jetbrains.rider",
      "com.jetbrains.pycharm",
      "com.jetbrains.datagrip",
      "com.jetbrains.intellij",
      "com.jetbrains.WebStorm",
      "com.jetbrains.toolbox"
    ]
  },
  {
    "id": "jetbrains.logs",
    "category": "apps",
    "app": "JetBrains",
    "title": "JetBrains IDE logs",
    "description": "Activity logs of JetBrains IDEs.",
    "safety": "safe",
    "paths": [
      "~/Library/Logs/JetBrains/*"
    ],
    "group": true,
    "action": {
      "type": "trash"
    }
  },
  {
    "id": "jetbrains.old-config",
    "category": "apps",
    "app": "JetBrains",
    "title": "Settings of older JetBrains IDE versions",
    "description": "Settings, plugins and local history of earlier IDE versions. The newer version imported them on its first launch; the newest version of each IDE is kept.",
    "safety": "caution",
    "kind": "versions",
    "paths": [
      "~/Library/Application Support/JetBrains"
    ],
    "versionPattern": "^(?<name>[A-Za-z]+)(?<version>[0-9]{4}\\.[0-9]+)$",
    "action": {
      "type": "trash"
    }
  },
  {
    "id": "jetbrains.config",
    "category": "apps",
    "app": "JetBrains",
    "title": "JetBrains IDE settings and plugins",
