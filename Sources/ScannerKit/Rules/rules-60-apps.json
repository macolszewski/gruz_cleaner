[
  {
    "id": "spotify.cache",
    "category": "apps",
    "app": "Spotify",
    "title": "Spotify music cache",
    "description": "Parts of played tracks stored for faster playback. Tracks downloaded for offline listening are stored elsewhere and are kept.",
