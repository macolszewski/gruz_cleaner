<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Git: %lld uncommitted changes. Check before removing!</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Git: %#@changes@. Check before removing!</string>
		<key>changes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld uncommitted change</string>
			<key>other</key>
			<string>%lld uncommitted changes</string>
		</dict>
	</dict>
	<key>Spotlight did not answer, so %lld possible app leftovers were not checked.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Spotlight did not answer, so %#@leftovers@ were not checked.</string>
		<key>leftovers</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld possible app leftover</string>
			<key>other</key>
			<string>%lld possible app leftovers</string>
		</dict>
	</dict>
</dict>
</plist>
