<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Git: %lld uncommitted changes. Check before removing!</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Git: %#@changes@. Sprawdź przed usunięciem!</string>
		<key>changes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld niezacommitowana zmiana</string>
			<key>few</key>
			<string>%lld niezacommitowane zmiany</string>
			<key>many</key>
			<string>%lld niezacommitowanych zmian</string>
			<key>other</key>
			<string>%lld niezacommitowanej zmiany</string>
		</dict>
	</dict>
	<key>Spotlight did not answer, so %lld possible app leftovers were not checked.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Spotlight nie odpowiedział, więc nie sprawdzono %#@leftovers@.</string>
		<key>leftovers</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld możliwej pozostałości po aplikacji</string>
			<key>few</key>
			<string>%lld możliwych pozostałości po aplikacjach</string>
			<key>many</key>
			<string>%lld możliwych pozostałości po aplikacjach</string>
			<key>other</key>
			<string>%lld możliwej pozostałości po aplikacjach</string>
		</dict>
	</dict>
</dict>
</plist>
